{
  "name": "vestigivo",
  "displayName": "Vestigivo RCA",
  "description": "Local-first Incident Intelligence & Root Cause Analysis with explicit evidence states.",
  "version": "0.1.0",
  "publisher": "armotusitio",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Testing"
  ],
  "keywords": [
    "incident",
    "observability",
    "root cause analysis",
    "opentelemetry",
    "logs"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onCommand:vestigivo.openControlCenter",
    "onCommand:vestigivo.importEvidence",
    "onView:vestigivo.launcher"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vestigivo.openControlCenter",
        "title": "Vestigivo RCA: Open Control Center"
      },
      {
        "command": "vestigivo.importEvidence",
        "title": "Vestigivo RCA: Import Evidence"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vestigivo",
          "title": "Vestigivo RCA",
          "icon": "media/brand/vestigivo-activity-bar.svg"
        }
      ]
    },
    "views": {
      "vestigivo": [
        {
          "id": "vestigivo.launcher",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Vestigivo RCA",
      "properties": {
        "vestigivo.maxImportBytes": {
          "type": "integer",
          "default": 8388608,
          "minimum": 1024,
          "maximum": 33554432,
          "description": "Maximum imported bytes per explicitly selected source."
        },
        "vestigivo.maxEvents": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum observations per source. Exceeding this limit produces a PARTIAL import."
        },
        "vestigivo.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "default": "auto"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "package:vsix": "npm run build && vsce package --no-dependencies",
    "check": "npm run build && node --experimental-test-coverage --test-coverage-include=dist/src/core/*.js --test-coverage-lines=85 --test-coverage-branches=80 --test dist/test/*.test.js",
    "brand:verify": "node scripts/verify-brand.cjs",
    "test:coverage": "npm run check",
    "test:host": "node dist/test/host/run.js",
    "test:vsix-host": "node dist/test/host/installed.js",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.3",
    "@vscode/test-electron": "^2.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Drako01/vestigivo.git"
  },
  "icon": "media/brand/vestigivo-icon-128.png"
}
